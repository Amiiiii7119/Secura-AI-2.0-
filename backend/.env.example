# ==============================================================================
# SECURA AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and supply your production credentials.
# NEVER commit real credentials or production passwords to version control.

# --- Application Configuration ---
APP_NAME=Secura AI
APP_ENV=production
DEBUG=false
SECRET_KEY=replace_with_a_64_character_hex_random_key

# --- PostgreSQL Managed Database Connection ---
# Supported providers: Neon, Supabase, AWS RDS, GCP Cloud SQL
# Standard format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_POSTGRES_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Server & CORS Origins ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=https://secura-ai.vercel.app,https://your-frontend-domain.vercel.app,http://localhost:5173

# --- Initial Bootstrap Credentials (Optional) ---
SECURA_ADMIN_USERNAME=admin
SECURA_ADMIN_EMAIL=admin@secura.ai
SECURA_ADMIN_PASSWORD=ChangeMeInProduction2026!

# --- Frontend Client Configuration ---
VITE_API_BASE_URL=https://your-backend-service.up.railway.app
